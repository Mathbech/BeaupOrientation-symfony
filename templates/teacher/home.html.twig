{% extends 'base.html.twig' %}
{% set has_navbar = true %}
{% set has_footer = false %}


{% block title %}{% endblock %}

{% block body %}
	<div class="container-fluid">
		<div class="card">
			<div class="card-header">
				<h3 class="card-title">Courses</h3>
			</div>
			<!-- /.card-header -->
			<div class="card-body">
				<table id="courses-table" class="table table-bordered table-striped">
					<thead>
						<tr>
							<th>Nom</th>
							<th>Marker</th>
						</tr>
					</thead>
					<tbody>
						{% for courseData in coursesData %}
							<tr>
								<td>{{ courseData.course_name }}</td>
								<td>{{ courseData.runners }}</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		</div>

		{# <div class="card">
			<div class="card-header">
