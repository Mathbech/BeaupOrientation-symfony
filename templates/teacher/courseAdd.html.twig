{% extends 'base.html.twig' %}
{% set has_navbar = true %}
{% set has_footer = false %}

{% block title %}{% endblock %}

{% block body %}
<section class="content" style="min-height: 100vh; display: flex; align-items: center;">
    <div class="container-fluid">
        <div class="row justify-content-center align-items-center" style="min-height: 80vh;">
            <!-- left column -->
            <div class="col-md-6">
                <div class="card card-primary">
                    <div class="card-header">
                        <h3 class="card-title">Ajouter une course</h3>
                    </div>
                    {{ form_start(form) }}
                    <div class="card-body">
                        <div class="form-group">
                            {{ form_label(form.name) }}
                            {{ form_widget(form.name, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        {# <div class="form-group">
                            {{ form_label(form.parcours) }}
                            {{ form_widget(form.parcours, {'attr': {'class': 'form-control'}}) }}
                        </div> #}
                    </div>
                    {{ form_rest(form) }}
                    <!-- /.card-body -->

                    <div class="card-footer">
                        <button type="submit" class="btn btn-primary">Submit</button>
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
