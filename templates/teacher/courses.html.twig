{% extends 'base.html.twig' %}
{% set has_navbar = true %}
{% set has_footer = false %}

{% block title %}Détails de la course{% endblock %}

{% block body %}
    <div class="container-fluid">
        <h1>{{ coursesData.name }}</h1>

        <h3>Runners</h3>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Nom</th>
                </tr>
            </thead>
            <tbody>
                {% for runner in coursesData.runners %}
                    <tr>
                        <td>{{ runner }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <h3>Markers</h3>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Latitude</th>
                    <th>Longitude</th>
                    <th>QR Code</th>
                </tr>
            </thead>
            <tbody>
                {% for marker in coursesData.markers %}
                    <tr>
                        <td>{{ marker.latitude }}</td>
                        <td>{{ marker.longitude }}</td>
                        <td>
                            {% if marker.qrCode %}
                                {{ marker.qrCode }}
                            {% else %}
                                <a href="{{ path('marker_generate_qr', { id: marker.id }) }}" class="btn btn-primary">
                                    Générer QR Code
                                </a>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
